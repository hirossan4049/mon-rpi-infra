[connection]
id={{ wifi_ssid }}
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid={{ wifi_ssid }}

[wifi-security]
key-mgmt=wpa-eap

[802-1x]
eap=peap;
identity={{ wifi_identity }}
password={{ wifi_password }}
phase2-auth=mschapv2
{% if wifi_ca_cert is defined %}
ca-cert={{ wifi_ca_cert }}
{% endif %}

[ipv4]
method=auto

[ipv6]
method=auto
